NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://jorunal.server.oldalexhub.com
DATABASE_URL=postgresql://innerfolio:change-me@127.0.0.1:5432/innerfolio
DATABASE_SSL=false
# Leave PYTHON_BIN unset for automatic private .venv provisioning.
# PYTHON_BIN=C:/managed/python/environment/Scripts/python.exe
NLP_MODEL=en_core_web_sm
WORKER_STARTUP_TIMEOUT_MS=120000
QUEUE_MAX=24
WORKER_CONCURRENCY=1
JOB_TIMEOUT_MS=45000
RESULT_TTL_SECONDS=900
TRUST_PROXY_HOPS=1
SESSION_SECRET=set-a-long-random-value-in-private-env
# Used automatically only when db:migrate finds no administrator.
ADMIN_USERNAME=set-in-private-env
# Remove this private value after the first successful database setup.
ADMIN_INITIAL_PASSWORD=set-in-private-env
