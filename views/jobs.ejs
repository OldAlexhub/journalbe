<%- include('partials/header') %><h1>Analysis jobs</h1><p>Only operational identifiers and status are retained. Submitted text and results are excluded.</p><div class="table-wrap"><table><thead><tr><th>ID</th><th>Installation</th><th>Status</th><th>Revision</th><th>Created</th><th>Duration</th><th>Error</th><th></th></tr></thead><tbody><% jobs.forEach(job => { %><tr><td><code><%= job.id %></code></td><td><code><%= job.installation_id %></code></td><td><span class="badge"><%= job.status %></span></td><td><%= job.entry_revision %></td><td><%= job.created_at.toISOString() %></td><td><%= job.duration_ms ?? '—' %></td><td><%= job.error_code ?? '—' %></td><td><% if (['queued','processing','completed'].includes(job.status)) { %><form method="post" action="/admin/jobs/<%= job.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf() %>"><button class="danger">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
