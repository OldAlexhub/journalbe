<%- include('partials/header') %><h1>Operations dashboard</h1><div class="grid"><article><h2>Express</h2><strong class="ok">Running</strong><p>Uptime <%= Math.floor(uptimeSeconds/60) %> minutes</p></article><article><h2>PostgreSQL</h2><strong class="<%= database.ready ? 'ok':'bad' %>"><%= database.ready ? 'Ready':'Unavailable' %></strong><p><%= database.latencyMs ?? database.code %><%= database.ready ? ' ms':'' %></p></article><article><h2>Text worker</h2><strong class="<%= worker.ready ? 'ok':'bad' %>"><%= worker.ready ? 'Ready':'Unavailable' %></strong><p><%= worker.model ? worker.model.name + ' ' + worker.model.version : 'Model not loaded' %></p></article><article><h2>Queue</h2><strong><%= queue.depth %></strong><p><%= queue.paused ? 'New jobs paused':'Accepting jobs' %></p></article></div><h2>Job status</h2><div class="grid"><% for (const [status,count] of Object.entries(jobs)) { %><article><h3><%= status %></h3><strong><%= count %></strong></article><% } %></div><h2>Recent operational errors</h2><div class="table-wrap"><table><thead><tr><th>Time</th><th>Component</th><th>Code</th></tr></thead><tbody><% errors.forEach(item => { %><tr><td><%= item.occurred_at.toISOString() %></td><td><%= item.component %></td><td><%= item.code %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
