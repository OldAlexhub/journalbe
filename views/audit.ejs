<%- include('partials/header') %><h1>Redacted audit trail</h1><table><thead><tr><th>Time</th><th>Administrator</th><th>Action</th><th>Target</th></tr></thead><tbody><% events.forEach(event => { %><tr><td><%= event.created_at.toISOString() %></td><td><%= event.username ?? 'system/unknown' %></td><td><%= event.action %></td><td><%= event.target_type ?? '' %> <code><%= event.target_id ?? '' %></code></td></tr><% }) %></tbody></table><%- include('partials/footer') %>
