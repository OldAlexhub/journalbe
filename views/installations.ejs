<%- include('partials/header') %><h1>Anonymous installations</h1><p>Opaque installation IDs only. No email, advertising ID, hardware fingerprint, or journal content.</p><div class="table-wrap"><table><thead><tr><th>ID</th><th>Created</th><th>Last seen</th><th>Jobs</th><th>Status</th><th>Actions</th></tr></thead><tbody><% installations.forEach(item => { %><tr><td><code><%= item.id %></code></td><td><%= item.created_at.toISOString() %></td><td><%= item.last_seen_at.toISOString() %></td><td><%= item.job_count %></td><td><%= item.deleted_at?'Deleted':item.revoked_at?'Revoked':'Active' %></td><td><% if (!item.revoked_at) { %><form method="post" action="/admin/installations/<%= item.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrf() %>"><button class="danger">Revoke</button></form><% } %><% if (!item.deleted_at) { %><form method="post" action="/admin/installations/<%= item.id %>/delete" onsubmit="return confirm('Delete all operational records for this installation?')"><input type="hidden" name="_csrf" value="<%= csrf() %>"><button class="danger">Delete data</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
