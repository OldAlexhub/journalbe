<%- include('partials/header') %><h1>Security</h1><% if(error){%><p class="alert"><%= error %></p><%}%><% if(success){%><p class="success"><%= success %></p><%}%><form method="post" action="/admin/security/password"><input type="hidden" name="_csrf" value="<%= csrf() %>"><label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label><label>New password<input type="password" name="newPassword" autocomplete="new-password" minlength="12" required></label><label>Confirm new password<input type="password" name="confirmPassword" autocomplete="new-password" minlength="12" required></label><button>Change password</button></form><form method="post" action="/admin/security/invalidate-sessions" onsubmit="return confirm('Sign out every administrator session, including this one?')"><input type="hidden" name="_csrf" value="<%= csrf() %>"><button class="danger">Invalidate all sessions</button></form><%- include('partials/footer') %>
